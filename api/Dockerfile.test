# The image the test runner uses (docker-compose.test.yml): Python 3.12 like the api image, plus pytest and everything the
# tests import. The source is NOT copied in: the compose file mounts the project folder, so a code change needs no rebuild.
# Build context is the repo root:   docker build -f api/Dockerfile.test .
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY api/requirements.txt api/requirements-dev.txt api/
RUN pip install --no-cache-dir -r api/requirements-dev.txt \
    simplemma rjieba janome kiwipiepy pypinyin pykakasi korean-romanizer
